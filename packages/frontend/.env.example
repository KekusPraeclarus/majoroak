# Copy to .env.local and fill in after the contracts are deployed.
# pnpm test:anvil writes .env.anvil.local for a local Robinhood mainnet fork.
# That file also sets VITE_INDEXER_URL to the local Worker.

# EscrowFactory address (required for the app to function)
VITE_FACTORY_ADDRESS=

# Block the factory was deployed at (used by the indexer and the local fallback)
VITE_START_BLOCK=0

# Indexer origin. Required in production. Example: https://indexer.example.workers.dev
VITE_INDEXER_URL=

# Development only. Set to 1 to scan the factory from the browser when the indexer is unset.
# VITE_INDEXER_FALLBACK=1

# Application base for the marketing pages. Empty means the same origin.
# Set this on the marketing host. Example: https://otc.example.com
# VITE_APP_URL=

# Marketing base for the application. Empty means the same origin.
# Set this on the application host, so the brand mark reaches the front door.
# Example: https://example.com
# VITE_SITE_URL=

# Defaults target Robinhood Chain mainnet. Override for testnet / local anvil:
# VITE_CHAIN_ID=4663
# VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# VITE_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Anvil-only. Address of the auto-connected local wallet. Not a private key.
# VITE_ANVIL_ACCOUNT=
